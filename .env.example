# Environment Variables for My Video Editor
# Copy this file to .env and fill in your actual API keys

# Environment Settings
ENV=dev
# ENV=prod for production deployment

# API Keys (Required for AI functionality)
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MEMORIES_AI_KEY=your_memories_ai_key_here

# Redis Configuration (Optional - for session management)
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here

# WebSocket Authentication
WS_TOKEN_VALIDATION=simple
WS_SECRET_KEY=your_websocket_secret_key_here

# Frontend Configuration (if using a frontend)
FRONTEND_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000
WS_BASE_URL=ws://localhost:8000

# Security Note: 
# - Never commit .env files to version control
# - Use strong, unique keys for production
# - Rotate keys regularly
